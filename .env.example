# Rime Voice AI Assistant Environment Variables (Template)
# Copy this file to backend/.env and replace placeholders with real credentials.

# Primary Spoken-Output Provider (Required)
RIME_API_KEY=your_rime_api_key_here

# LLM Providers (Required)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Engine Configuration
LLM_PROVIDER=groq
STT_PROVIDER=groq
